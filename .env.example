# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Apify API
APIFY_API_TOKEN=your_apify_api_token_here

# BetterContact (required by OpenOutreach for both discovery and enrichment)
BETTERCONTACT_API_KEY=your_bettercontact_api_key_here

# Contact Compass (email finding - 20k free lookups)
# Used for finding work emails from LinkedIn profiles.
# ROX Test calls https://api.contactcompass.io/v1/people/search directly
# with the key sent in the `x-api-token` header.
# Sign up at https://contactcompass.io
CONTACT_COMPASS_API_KEY=your_contact_compass_api_key_here

# OpenOutreach setup
OPENOUTFIND_PRODUCT_DOCS=
OPENOUTFIND_CAMPAIGN_TARGET=
OPENOUTFIND_AI_MODEL=groq:openai/gpt-oss-120b
OPENOUTFIND_LLM_API_KEY=your_groq_api_key_here
OPENOUTFIND_BETTERCONTACT_API_KEY=your_bettercontact_api_key_here
OPENOUTFIND_OPERATOR_EMAIL=your_email@example.com
OPENOUTFIND_OPERATOR_COUNTRY=IN
OPENOUTFIND_ACCEPT_LEGAL_NOTICE=true

# Apify Actor IDs (get from Apify Console)
APIFY_SEARCH_ACTOR_ID=harvestapi/linkedin-profile-search-by-name
APIFY_PROFILE_ACTOR_ID=harvestapi/linkedin-profile-scraper
